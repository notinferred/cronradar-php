{
    "name": "cronradar/php",
    "description": "Non-blocking lifecycle and heartbeat monitoring for PHP cron jobs, with missed-run, failure, and stuck-run detection.",
    "keywords": ["cron", "monitoring", "scheduled-jobs", "recurring-jobs", "missed-jobs", "failed-jobs", "stuck-jobs", "heartbeat"],
    "homepage": "https://cronradar.com/php",
    "license": "proprietary",
    "authors": [
        {
            "name": "CronRadar",
            "email": "support@cronradar.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "CronRadar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CronRadar\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests/"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
